#!/bin/sh
# dotscurb: appends what's missing of: Cursor CLI file credential store (works over SSH), direnv hook, worktrunk
# shell integration. Each line is guarded, so it is harmless when the tool isn't installed. The rest stays yours.
t=$(mktemp); cat > "$t"; cat "$t"
out=$(
  grep -q 'AGENT_CLI_CREDENTIAL_STORE' "$t" || echo 'export AGENT_CLI_CREDENTIAL_STORE=file   # dotscurb'
  grep -q 'direnv hook' "$t" || echo 'command -v direnv >/dev/null && eval "$(direnv hook zsh)"   # dotscurb'
  grep -q 'wt config shell init' "$t" || echo 'command -v wt >/dev/null && eval "$(command wt config shell init zsh)"   # dotscurb'
)
[ -n "$out" ] && { [ -s "$t" ] && echo; printf '%s\n' "$out"; }
rm -f "$t"
