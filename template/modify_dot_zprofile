#!/bin/sh
# dotscurb: appends one PATH line (mise tools, the dotscurb and dotagents commands) unless the file already puts
# the mise shims on PATH. Everything else in this file stays yours.
t=$(mktemp); cat > "$t"; cat "$t"
grep -q 'mise/shims' "$t" || { [ -s "$t" ] && echo; printf '%s\n' 'export PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:$PATH"   # dotscurb'; }
rm -f "$t"
