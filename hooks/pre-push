#!/bin/sh
# dotscurb: refuses to push commits that carry agent attribution lines (second layer behind
# prepare-commit-msg), then hands over to the repo's own pre-push. `git push --no-verify` skips it.
. "$(dirname "$0")/_chain.sh"
remote="$1"
zero=0000000000000000000000000000000000000000
pat='^(Co-Authored-By: (Claude|Codex|Cursor)|Made-with: Cursor|Claude-Session:)|Generated with \[Claude Code\]'
input=$(cat)
bad=0
while read -r lref lsha rref rsha; do
  [ -n "$lsha" ] || continue
  [ "$lsha" = "$zero" ] && continue
  if [ "$rsha" = "$zero" ]; then range="$lsha --not --remotes=$remote"; else range="$rsha..$lsha"; fi
  commits=$(git rev-list $range 2>/dev/null) || commits=$(git rev-list "$lsha" --not --remotes="$remote" 2>/dev/null)
  for c in $commits; do
    if git log -1 --format=%B "$c" | grep -qiE "$pat"; then
      echo "push rejected: commit $(git log -1 --format='%h %s' "$c") carries an agent attribution line" >&2
      bad=1
    fi
  done
done <<INPUT
$input
INPUT
[ "$bad" = 0 ] || exit 1
printf '%s\n' "$input" | dotscurb_chain pre-push "$@"
