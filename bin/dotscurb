#!/bin/sh
# dotscurb: only the glue the other tools don't provide (chezmoi places files, mise installs tools, dotagents
# handles skills/MCP/plugins, git runs the hooks in ../hooks).
#   dotscurb apply         render the policy into Claude Code + Cursor CLI, and switch on in Claude the plugins
#                          dotagents declares (dotagents only generates the marketplace)
#   dotscurb check         list MCP servers and plugins installed outside dotagents (read-only)
#   dotscurb check --fix   move them into dotagents and remove the native copy (never copies secret values)
#   dotscurb init          first-time setup: asks a few questions, wires dotscurb into your own chezmoi dotfiles
#                          repo (creates one if you have none), then applies. Again with: dotscurb init --reconfigure
#   dotscurb setup         install tools (mise), skills/MCP/plugins (dotagents), herdr hooks, then apply; the
#                          first time it also runs doctor. chezmoi runs this after every apply.
#   dotscurb doctor        checklist: tools, git, agent logins, herdr, unmanaged items, your project folders
set -u

self=$0
while [ -L "$self" ]; do t=$(readlink "$self"); case $t in /*) self=$t ;; *) self=$(dirname "$self")/$t ;; esac; done
ROOT=$(cd "$(dirname "$self")/.." && pwd -P)
A="$HOME/.agents"
PATH="$HOME/.local/share/mise/shims:$HOME/.local/bin:$PATH"; export PATH
QUIET=0
TAB=$(printf '\t')

say() { [ "$QUIET" = 1 ] || printf '%s\n' "$*"; }
warn() { printf 'dotscurb: %s\n' "$*" >&2; }
need() { command -v "$1" >/dev/null 2>&1 || { warn "$1 not found (it comes from mise: mise install)"; exit 1; }; }

# put <file> <tmpfile>: replace contents only when they differ (keeps owner, group and mode)
put() {
  if [ -f "$1" ] && cmp -s "$2" "$1"; then rm -f "$2"; return 1; fi
  mkdir -p "$(dirname "$1")" && cat "$2" > "$1" && rm -f "$2" && say "updated ~/${1#$HOME/}"
}

# jsonedit <file> <jq-program> [jq args…]: apply only if the result differs semantically (no reformat churn)
jsonedit() {
  f=$1; prog=$2; shift 2
  [ -f "$f" ] || return 0
  new=$(mktemp) || return 1
  jq "$@" "$prog" "$f" > "$new" || { rm -f "$new"; warn "could not update $f"; return 1; }
  if [ "$(jq -S . "$f")" = "$(jq -S . "$new")" ]; then rm -f "$new"; return 0; fi
  put "$f" "$new"
}

policy_json() {
  def=$(yq -o=json '. // {}' "$ROOT/defaults/policy.yaml") || { warn "could not read defaults/policy.yaml (yq failed)"; exit 1; }
  per='{}'; [ -f "$A/policy.yaml" ] && { per=$(yq -o=json '. // {}' "$A/policy.yaml") || { warn "could not read ~/.agents/policy.yaml (yq failed)"; exit 1; }; }
  jq -n --argjson a "$def" --argjson b "$per" '
    def u: reduce .[] as $x ([]; if index([$x]) then . else . + [$x] end);
    { denyRead: (($a.denyRead // []) + ($b.denyRead // []) | u),
      denyWrite: (($a.denyWrite // []) + ($b.denyWrite // []) | u),
      denyCommands: (($a.denyCommands // []) + ($b.denyCommands // []) | u) }'
}

CP="$HOME/.claude/plugins"   # Claude Code's plugin records

cmd_apply() {
  need jq; need yq
  # 1. policy → Claude Code (deny rules, attribution off, session-start check)
  pol=$(policy_json)
  [ -f "$HOME/.claude/settings.json" ] || { mkdir -p "$HOME/.claude" && echo "{}" > "$HOME/.claude/settings.json"; }
  jsonedit "$HOME/.claude/settings.json" '
    .permissions.deny = [($p.denyRead[] | "Read(\(.))"), ($p.denyWrite[] | "Edit(\(.))"),
      ($p.denyCommands[] | if (.args // "") != "" then "Bash(\(.cmd) \(.args)*)" else "Bash(\(.cmd) *)" end)]
    | .attribution.commit = "" | .attribution.pr = ""
    | .hooks.SessionStart = ((.hooks.SessionStart // [])
        | if any(.[]; any(.hooks[]?; (.command // "") | test("dotscurb check"))) then .
          else . + [{"hooks": [{"type": "command", "command": $hook}]}] end)' \
    --argjson p "$pol" --arg hook "$HOME/.local/bin/dotscurb check --session"
  # 2. policy → Cursor CLI (absolute paths; Shell(cmd:args*) format)
  jsonedit "$HOME/.cursor/cli-config.json" '
    def abs: sub("^~/"; $home + "/");
    .permissions.deny = [($p.denyRead[] | "Read(\(abs))"), ($p.denyWrite[] | "Write(\(abs))"),
      ($p.denyCommands[] | if (.args // "") != "" then "Shell(\(.cmd):\(.args)*)" else "Shell(\(.cmd))" end)]
    | .attribution.attributeCommitsToAgent = false | .attribution.attributePRsToAgent = false' \
    --argjson p "$pol" --arg home "$HOME"
  # 3. plugins declared in ~/.agents/agents.toml → switched on in Claude Code (dotagents issue #176:
  #    it generates ~/.agents/.claude-plugin/marketplace.json but never registers or installs it)
  mk="$A/.claude-plugin/marketplace.json"
  if command -v claude >/dev/null 2>&1 && [ -f "$mk" ]; then
    jq -e '.dotagents' "$CP/known_marketplaces.json" >/dev/null 2>&1 || \
      { claude plugin marketplace add "$A" >/dev/null 2>&1 && say "Claude: added the dotagents plugin marketplace"; }
    claude plugin marketplace update dotagents >/dev/null 2>&1 || true
    want=$(jq -r '.plugins[].name' "$mk")
    have=$(jq -r '.plugins // {} | keys[] | select(endswith("@dotagents")) | sub("@dotagents$"; "")' "$CP/installed_plugins.json" 2>/dev/null)
    for n in $want; do printf '%s\n' "$have" | grep -qx -- "$n" && continue
      claude plugin install "$n@dotagents" --scope user >/dev/null 2>&1 && say "Claude: switched on plugin $n" || warn "Claude: could not install plugin $n"; done
    for n in $have; do printf '%s\n' "$want" | grep -qx -- "$n" && continue
      claude plugin uninstall "$n@dotagents" --scope user >/dev/null 2>&1 && say "Claude: switched off plugin $n (no longer in agents.toml)"; done
  fi
  # 4. plugins declared in this repo's agents.toml → switched on in Claude for this project only (scope local).
  #    dotagents' project marketplace is also named "dotagents", which Claude can't register twice, so Claude
  #    installs from the plugin's own marketplace (recorded in the copy dotagents keeps).
  repo=$(git rev-parse --show-toplevel 2>/dev/null || true)
  if command -v claude >/dev/null 2>&1 && [ -n "$repo" ] && [ -f "$repo/agents.toml" ]; then
    for n in $(yq -p toml -o json '[(.plugins // [])[].name]' "$repo/agents.toml" | jq -r '.[]'); do
      m=$(jq -r '.name // empty' "$repo/.agents/plugins/$n/.claude-plugin/marketplace.json" 2>/dev/null)
      src=$(yq -p toml -o json "[(.plugins // [])[] | select(.name == \"$n\") | .source][0]" "$repo/agents.toml" | jq -r '. // empty')
      [ -n "$m" ] && [ -n "$src" ] || { warn "Claude: plugin $n has no Claude marketplace; not switched on"; continue; }
      jq -e --arg m "$m" '.[$m]' "$CP/known_marketplaces.json" >/dev/null 2>&1 || claude plugin marketplace add "$src" >/dev/null 2>&1
      jq -e --arg k "$n@$m" --arg r "$repo" '.plugins[$k] // [] | any(.projectPath == $r or .scope == "user")' "$CP/installed_plugins.json" >/dev/null 2>&1 \
        || { (cd "$repo" && claude plugin install "$n@$m" --scope local >/dev/null 2>&1) && say "Claude: switched on plugin $n for this project" || warn "Claude: could not install plugin $n for this project"; }
    done
  fi
}

# --- check / fix -----------------------------------------------------------------------------------------
# normalise one native MCP entry (Claude/Cursor/pi JSON, Codex TOML, OpenCode) to {url, cmd, headers, envkeys, secret}
JQ_NORM='def lit: tostring | test("\\$\\{|\\{env:") | not;
  { url: (.url // null),
    cmd: (if .command then ([.command] + (.args // []) | flatten | map(tostring) | join(" ")) else null end),
    headers: ((.headers // .http_headers // {}) | to_entries | map("\(.key):\(.value)")),
    envkeys: (((.env // .environment // {}) | keys) + (.env_vars // [])),
    secret: ([(.env // .environment // {}), (.headers // .http_headers // {})] | add | to_entries
             | map(select(.value | lit)) | length > 0) }'
# mcp_from <file> <jq-path> <scope: user|project> <agent> [toml] → TSV: name scope agent json
mcp_from() {
  [ -f "$1" ] || return 0
  if [ "${5:-}" = toml ]; then yq -p toml -o json "$2 // {}" "$1" 2>/dev/null; else jq "$2 // {}" "$1" 2>/dev/null; fi \
    | jq -r --arg s "$3" --arg a "$4" "to_entries[] | [.key, \$s, \$a, (.value | $JQ_NORM | tojson)] | @tsv" 2>/dev/null
}
native_items() { # TSV: kind name scope agent detail
  repo=$1
  { mcp_from "$HOME/.claude.json" '.mcpServers' user Claude
    [ -n "$repo" ] && mcp_from "$HOME/.claude.json" ".projects[\"$repo\"].mcpServers" project Claude-local
    [ -n "$repo" ] && mcp_from "$repo/.mcp.json" '.mcpServers' project Claude
    mcp_from "$HOME/.cursor/mcp.json" '.mcpServers' user Cursor
    [ -n "$repo" ] && mcp_from "$repo/.cursor/mcp.json" '.mcpServers' project Cursor
    mcp_from "$HOME/.codex/config.toml" '.mcp_servers' user Codex toml
    [ -n "$repo" ] && mcp_from "$repo/.codex/config.toml" '.mcp_servers' project Codex toml
    mcp_from "$HOME/.pi/agent/mcp.json" '.mcpServers' user pi
    [ -n "$repo" ] && mcp_from "$repo/.pi/mcp.json" '.mcpServers' project pi
    mcp_from "$HOME/.config/opencode/opencode.json" '.mcp' user OpenCode
  } | sed "s/^/mcp$TAB/"
  # Claude plugins from a marketplace other than dotagents (claude.ai-synced ones are Claude's own)
  [ -f "$CP/installed_plugins.json" ] && jq -r --arg repo "$repo" --slurpfile km "$CP/known_marketplaces.json" '
    .plugins // {} | to_entries[] | (.key | split("@")) as [$n, $m]
    | select($m != "dotagents" and $m != "synced") | .value[]
    | select(.scope == "user" or .projectPath == $repo)
    | ["plugin", $n, (if .scope == "user" then "user" else "project" end), "Claude",
       ({market: $m, repo: ($km[0][$m].source.repo // null), ref: (.gitCommitSha // null), claudeScope: .scope} | tojson)]
    | @tsv' "$CP/installed_plugins.json" 2>/dev/null
  true
}

cmd_check() {
  need jq; need yq
  session=0; fix=0; projonly=0
  for a in "$@"; do case $a in --session) session=1 ;; --fix) fix=1 ;; --project-only) projonly=1 ;; esac; done
  repo=$(git rev-parse --show-toplevel 2>/dev/null || true)
  declared=""
  for t in "$A/agents.toml" ${repo:+"$repo/agents.toml"}; do
    [ -f "$t" ] || continue
    j=$(yq -p toml -o json '[(.mcp // [])[].name, (.plugins // [])[].name]' "$t") || { warn "could not read $t (yq failed)"; return 1; }
    declared="$declared
$(printf '%s' "$j" | jq -r '.[]')"
  done
  items=$(native_items "$repo" | while IFS="$TAB" read -r kind name scope agent detail; do
    [ -n "$name" ] || continue
    [ "$projonly" = 1 ] && [ "$scope" = user ] && continue
    printf '%s\n' "$declared" | grep -qx -- "$name" && continue
    printf '%s\t%s\t%s\t%s\t%s\n' "$kind" "$name" "$scope" "$agent" "$detail"
  done | sort -u -t "$TAB" -k1,3)
  if [ -z "$items" ]; then [ "$session" = 1 ] || echo "dotscurb: everything is managed by dotagents"; return 0; fi
  if [ "$fix" = 0 ]; then
    echo "dotscurb: installed outside dotagents, so other agents and machines don't get them:"
    printf '%s\n' "$items" | while IFS="$TAB" read -r kind name scope agent detail; do
      s=""; [ "$(printf '%s' "$detail" | jq -r '.secret // false')" = true ] && s="  ⚠ secret value in config, move it by hand"
      printf '  - %s %s  (%s, %s)%s\n' "$kind" "$name" "$agent" "$( [ "$scope" = user ] && echo every project || echo this project)" "$s"
    done
    echo "Run 'dotscurb check --fix' to move them into dotagents (secret values are never copied)."
    return 0
  fi
  need dotagents
  printf '%s\n' "$items" | while IFS="$TAB" read -r kind name scope agent detail; do
    flag=--global; dir=$HOME; [ "$scope" = project ] && { flag=--project; dir=$repo; }
    if [ "$kind" = mcp ]; then
      if [ "$(printf '%s' "$detail" | jq -r .secret)" = true ]; then warn "skipped MCP $name ($agent): its config holds a secret value; move the value to an env var first"; continue; fi
      set -- mcp add "$name"
      url=$(printf '%s' "$detail" | jq -r '.url // empty'); cmdline=$(printf '%s' "$detail" | jq -r '.cmd // empty')
      if [ -n "$url" ]; then set -- "$@" --url "$url"
        for h in $(printf '%s' "$detail" | jq -r '.headers[] | @base64'); do set -- "$@" --header "$(printf '%s' "$h" | base64 -d)"; done
      elif [ -n "$cmdline" ]; then set -- "$@" --command "$cmdline"
      else warn "skipped MCP $name: neither url nor command"; continue; fi
      for e in $(printf '%s' "$detail" | jq -r '.envkeys[]'); do set -- "$@" --env "$e"; done
      case $agent in   # Claude keeps its own copy under a different scope; remove it so dotagents' copy is the only one
        Claude) (cd "$dir" && claude mcp remove "$name" -s user >/dev/null 2>&1) ;;
        Claude-local) (cd "$dir" && claude mcp remove "$name" -s local >/dev/null 2>&1) ;;
      esac
      (cd "$dir" && dotagents "$flag" "$@" >/dev/null 2>&1) && say "moved MCP $name ($agent) into dotagents ($flag)" || warn "could not add MCP $name to dotagents"
    else
      src=$(printf '%s' "$detail" | jq -r '.repo // empty'); ref=$(printf '%s' "$detail" | jq -r '.ref // empty')
      mkt=$(printf '%s' "$detail" | jq -r .market)
      if [ -z "$src" ]; then warn "skipped plugin $name: its marketplace $mkt has no GitHub source"; continue; fi
      if [ "$scope" != user ]; then   # project-level: dotagents records it in the repo; Claude keeps its project install
        [ -f "$repo/agents.toml" ] || { agents=$(yq -p toml -o json '.agents // []' "$A/agents.toml" 2>/dev/null | jq -c .); printf 'version = 1\nagents = %s\n' "${agents:-[]}" > "$repo/agents.toml"; }
        (cd "$repo" && dotagents --project add "$src" --name "$name" ${ref:+--ref "$ref"} >/dev/null 2>&1) \
          && say "recorded plugin $name ($src) in this project's agents.toml; Claude keeps its project install" \
          || warn "could not add plugin $name ($src) to this project's agents.toml"
        continue
      fi
      if (cd "$dir" && dotagents --global add "$src" --name "$name" ${ref:+--ref "$ref"} >/dev/null 2>&1); then
        claude plugin uninstall "$name@$mkt" --scope user >/dev/null 2>&1
        say "moved plugin $name ($src) into dotagents; removed Claude's own copy"
      else warn "could not add plugin $name ($src) to dotagents"; fi
    fi
  done
  (cd "$HOME" && dotagents --global sync >/dev/null 2>&1) || true
  [ -n "$repo" ] && [ -f "$repo/agents.toml" ] && (cd "$repo" && dotagents --project install >/dev/null 2>&1)
  cmd_apply
}

# --- init: wire dotscurb into the user's own chezmoi repo -------------------------------------------------
TOOLS_ASKED="node:node:Node.js 22 (dotagents needs Node 20+)
claude:claude:Claude Code
codex:codex:Codex CLI
cursor-agent:cursor-agent:Cursor CLI
npm:@earendil-works/pi-coding-agent:pi:pi coding agent
herdr:herdr:herdr (terminal multiplexer for agents)
worktrunk:wt:worktrunk (wt, git worktree helper)
direnv:direnv:direnv (per-folder env, no secrets)
tmux:tmux:tmux (terminal multiplexer)
uv:uv:uv (Python tools and MCP servers)
gitleaks:gitleaks:gitleaks (secret scanner for commits)"

ask() { # ask <question> <default> → answer on stdout (default when there is no terminal)
  if [ -r /dev/tty ] && [ -w /dev/tty ]; then
    printf '%s%s: ' "$1" "${2:+ [$2]}" > /dev/tty; IFS= read -r _a < /dev/tty || _a=""
  else _a=""; fi
  printf '%s' "${_a:-$2}"
}
yes_no() { _d=$2; _r=$(ask "$1 (y/n)" "$_d"); case $_r in y|Y|yes|Yes) return 0 ;; *) return 1 ;; esac; }
target_of() { printf '%s\n' "$1" | sed -E 's#(^|/)((modify|create|symlink|private|executable|run_after|run_once_after)_)+#\1#g; s#(^|/)dot_#\1.#g; s#\.tmpl$##'; }
toml_list() { printf '%s' "$1" | tr ',' '\n' | sed 's/^ *//; s/ *$//' | sed '/^$/d' | sed 's/.*/"&"/' | paste -sd, - | sed 's/^/[/; s/$/]/'; }

cmd_init() {
  reconf=0; for a in "$@"; do [ "$a" = --reconfigure ] && reconf=1; done
  export PATH="$HOME/.local/bin:$PATH"
  if ! command -v chezmoi >/dev/null 2>&1; then
    echo "Installing chezmoi into ~/.local/bin…"
    sh -c "$(curl -fsLS get.chezmoi.io)" -- -b "$HOME/.local/bin" >/dev/null || { warn "could not install chezmoi"; exit 1; }
  fi
  src=$(chezmoi source-path 2>/dev/null)
  created=0
  if [ -z "$src" ] || [ ! -d "$src" ] || [ -z "$(ls -A "$src" 2>/dev/null)" ]; then
    echo "dotscurb keeps your personal settings in YOUR OWN dotfiles repo (chezmoi); dotscurb itself only holds the shared parts."
    url=$(ask "Your dotfiles repo (git URL or GitHub user), empty to start a new one" "")
    if [ -n "$url" ]; then chezmoi init "$url" || { warn "chezmoi init $url failed"; exit 1; }
    else chezmoi init >/dev/null || { warn "chezmoi init failed"; exit 1; }; created=1; fi
    src=$(chezmoi source-path)
  fi
  top=$(git -C "$src" rev-parse --show-toplevel 2>/dev/null || printf '%s' "$src")
  echo "Your dotfiles repo: $top"
  managed=$(chezmoi managed -i files,symlinks 2>/dev/null)
  is_managed() { printf '%s\n' "$managed" | grep -qxF -- "$1"; }
  changed=""
  note() { changed="$changed
  $1"; }

  # 1. answers → .chezmoidata/dotscurb.toml (personal, in your repo) and the optional-tools file
  data="$src/.chezmoidata/dotscurb.toml"
  if [ ! -f "$data" ] || [ "$reconf" = 1 ]; then
    gh_login=""; gh_id=""
    command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1 && { gh_login=$(gh api user --jq .login 2>/dev/null); gh_id=$(gh api user --jq .id 2>/dev/null); }
    pdef=""; for d in "$HOME/code" "$HOME/Documents/repos" "$HOME/src" "$HOME/projects" "$HOME/dev"; do [ -d "$d" ] && pdef="$pdef${pdef:+, }~${d#$HOME}"; done
    name=$(ask "Your full name (git commits)" "$(git config --global user.name)")
    email=$(ask "Your email (git commits)" "$(git config --global user.email)")
    github=$(ask "Your GitHub username (agent co-author line)" "$gh_login")
    gid=$(ask "Your GitHub numeric id (gh api user --jq .id)" "$gh_id")
    projects=$(ask "Folders that hold your git repos, comma-separated" "${pdef:-~/code}")
    mkdir -p "$src/.chezmoidata"
    { echo "# dotscurb answers (dotscurb init). Personal: lives in your dotfiles repo, not in dotscurb."
      echo "[dotscurb]"
      printf 'name = "%s"\nemail = "%s"\ngithub = "%s"\ngithubId = "%s"\nprojects = %s\n' "$name" "$email" "$github" "$gid" "$(toml_list "$projects")"
    } > "$data"; note ".chezmoidata/dotscurb.toml (your answers)"
    if ! is_managed .config/mise/conf.d/dotscurb-extras.toml || [ "$reconf" = 1 ]; then
      echo "Optional tools, installed and pinned per machine by mise (default yes only if not on this machine):"
      ex="$src/dot_config/mise/conf.d/dotscurb-extras.toml"; mkdir -p "$(dirname "$ex")"
      { echo "# Optional tools chosen at dotscurb init. Yours: edit freely, then chezmoi apply."; echo "[tools]"
        printf '%s\n' "$TOOLS_ASKED" | while IFS= read -r line; do
          tool=${line%:*:*}; rest=${line#"$tool":}; cmd=${rest%%:*}; label=${rest#*:}
          d=y; command -v "$cmd" >/dev/null 2>&1 && d=n
          case $tool in npm:*) key="\"$tool\"" ;; *) key=$tool ;; esac
          if yes_no "  $label$( [ $d = n ] && echo ' — already installed here')" "$d"; then
            [ "$tool" = node ] && echo 'node = "22"' || echo "$key = \"latest\""; fi
        done; } > "$ex"; note "dot_config/mise/conf.d/dotscurb-extras.toml (your optional tools)"
    fi
  fi

  # 2. the shared wiring: copy template files you don't manage yet; patch plain files you do
  ( cd "$ROOT/template" && find . -type f | sed 's#^\./##' ) | while IFS= read -r rp; do
    case $rp in .chezmoiscripts/*)
      grep -rqs 'dotscurb setup' "$src/.chezmoiscripts" && continue
      mkdir -p "$src/.chezmoiscripts"; cp "$ROOT/template/$rp" "$src/$rp"; echo "  + $rp"; continue ;; esac
    tgt=$(target_of "$rp")
    if is_managed "$tgt"; then
      sp=$(chezmoi source-path "$HOME/$tgt" 2>/dev/null); base=$(basename "$sp")
      case $rp in modify_*) ;; *) continue ;; esac   # links/created files you manage: yours win
      case $base in *.tmpl|modify_*|symlink_*) echo "  ! ~/$tgt is a template in your repo; add dotscurb's lines by hand (see $ROOT/template/$rp)"; continue ;; esac
      t=$(mktemp)
      case $rp in *.tmpl) chezmoi execute-template < "$ROOT/template/$rp" > "$t.sh" ;; *) cp "$ROOT/template/$rp" "$t.sh" ;; esac
      sh "$t.sh" < "$sp" > "$t" && ! cmp -s "$t" "$sp" && { cat "$t" > "$sp"; echo "  ~ ${sp#$src/} (added dotscurb's lines)"; }
      rm -f "$t" "$t.sh"
    else
      mkdir -p "$(dirname "$src/$rp")"; cp "$ROOT/template/$rp" "$src/$rp"; echo "  + $rp"
    fi
  done
  # 3. fetch dotscurb on every machine that applies your repo
  if ! cat "$src"/.chezmoiexternal.* 2>/dev/null | grep -q 'local/share/dotscurb'; then
    ext="$src/.chezmoiexternal.toml"; [ -f "$src/.chezmoiexternal.toml.tmpl" ] && ext="$src/.chezmoiexternal.toml.tmpl"
    url=$(git -C "$ROOT" remote get-url origin 2>/dev/null || echo https://github.com/safa0/dotscurb.git)
    { [ -s "$ext" ] && echo; echo "# dotscurb: shared agent glue, fetched next to your dotfiles"
      printf '[".local/share/dotscurb"]\n    type = "git-repo"\n    url = "%s"\n    refreshPeriod = "24h"\n' "$url"; } >> "$ext"
    echo "  + ${ext#$src/} (fetches dotscurb)"
  fi
  # 4. your skills/MCP list and policy additions, if your repo doesn't have them yet
  if ! is_managed .agents/agents.toml; then
    if [ -f "$A/agents.toml" ]; then chezmoi add "$A/agents.toml" && echo "  + dot_agents/agents.toml (your existing one)"
    else mkdir -p "$src/dot_agents"; cp "$ROOT/defaults/agents.toml" "$src/dot_agents/agents.toml"; echo "  + dot_agents/agents.toml (starter)"; fi
  fi
  if ! is_managed .agents/policy.yaml; then
    if [ -f "$A/policy.yaml" ]; then chezmoi add "$A/policy.yaml" && echo "  + dot_agents/policy.yaml (your existing one)"
    else mkdir -p "$src/dot_agents"; printf '# Your additions to the dotscurb policy (%s). Same keys; dotscurb apply combines both.\ndenyRead: []\ndenyWrite: []\ndenyCommands: []\n' "~/.local/share/dotscurb/defaults/policy.yaml" > "$src/dot_agents/policy.yaml"; echo "  + dot_agents/policy.yaml (empty)"; fi
  fi
  [ -n "$changed" ] && printf 'Wrote:%s\n' "$changed"

  echo; echo "Changes in your dotfiles repo:"; git -C "$top" status --short 2>/dev/null
  echo; chezmoi diff --no-pager --exclude scripts 2>/dev/null | head -80
  yes_no "Apply to your home folder now?" y || { echo "Not applied. Later: chezmoi apply"; return 0; }
  chezmoi apply || warn "chezmoi apply reported errors"
  if [ "$created" = 1 ]; then
    git -C "$top" add -A && git -C "$top" commit -qm "feat(dotfiles): start dotfiles with dotscurb" && echo "Committed in $top"
    if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1 && yes_no "Create a PRIVATE GitHub repo 'dotfiles' for it and push?" y; then
      (cd "$top" && gh repo create dotfiles --private --source . --push) && echo "Other machines: dotscurb's install.sh, then give it this repo."
    else echo "Your dotfiles repo is local only. Add a remote later: chezmoi cd; gh repo create dotfiles --private --source . --push"; fi
  else
    echo "Review and commit in your dotfiles repo: chezmoi cd; git status; git commit"
  fi
}

ensure_agents_files() { # standalone fallback when no dotfiles repo provides them
  [ -f "$A/agents.toml" ] || { mkdir -p "$A" && cp "$ROOT/defaults/agents.toml" "$A/agents.toml" && say "created ~/.agents/agents.toml"; }
}

# --- setup / doctor --------------------------------------------------------------------------------------
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/dotscurb"
AGENTS_CLI="claude codex cursor-agent pi opencode"

cmd_setup() {
  if ! command -v mise >/dev/null 2>&1; then
    say "installing mise…"
    if command -v brew >/dev/null 2>&1; then brew install mise >/dev/null; else curl -fsSL https://mise.run | sh >/dev/null; fi \
      || { warn "could not install mise; see https://mise.jdx.dev/getting-started.html"; exit 1; }
  fi
  mise install --yes >/dev/null 2>&1 || warn "mise install failed; run 'mise install' to see why"
  ensure_agents_files
  if command -v dotagents >/dev/null 2>&1; then
    (cd "$HOME" && { dotagents --global doctor >/dev/null 2>&1 || dotagents --global install >/dev/null 2>&1; dotagents --global sync >/dev/null 2>&1; }) \
      || warn "dotagents failed; run 'dotagents --global doctor'"
  else warn "dotagents not available (needs Node 20+; answer yes to node when chezmoi asks, or install it)"; fi
  # herdr: its agent-state hooks for every installed agent it supports (claude, codex, pi, opencode)
  if command -v herdr >/dev/null 2>&1; then
    st=$(herdr integration status 2>/dev/null)
    for a in claude codex pi opencode; do command -v "$a" >/dev/null 2>&1 || continue
      printf '%s\n' "$st" | grep -q "^$a: not installed" || continue
      herdr integration install "$a" >/dev/null 2>&1 && say "herdr: installed the $a integration" || warn "herdr: could not install the $a integration"
    done
  fi
  cmd_apply
  if [ ! -f "$STATE/onboarded" ]; then
    QUIET=0; cmd_doctor; mkdir -p "$STATE" && date > "$STATE/onboarded"
  fi
}

# project folders: git config dotscurb.projects (one or more values; ~ allowed)
project_dirs() { git config --global --get-all dotscurb.projects 2>/dev/null | sed "s|^~|$HOME|"; }
project_repos() { # git repos up to two levels below each project folder (worktree folders skipped)
  project_dirs | while IFS= read -r d; do [ -d "$d" ] || continue
    for g in "$d"/*/.git "$d"/*/*/.git; do [ -e "$g" ] || continue
      r=${g%/.git}; case $r in *-worktrees/*) continue ;; esac; [ -d "$g" ] && printf '%s\n' "$r"; done
  done
}

cmd_doctor() {
  todo=0
  ok() { printf '  ✓ %s\n' "$1"; }
  no() { printf '  ✗ %s\n      → %s\n' "$1" "$2"; todo=$((todo+1)); }
  echo "dotscurb doctor"
  echo "Tools"
  for c in git mise jq yq rg fd ast-grep gh; do command -v "$c" >/dev/null 2>&1 && ok "$c" || no "$c missing" "mise install"; done
  if command -v node >/dev/null 2>&1 && [ "$(node -p 'process.versions.node.split(".")[0]' 2>/dev/null || echo 0)" -ge 20 ]; then ok "node $(node -v)"
  else no "Node 20+ missing (dotagents needs it)" "add node = \"22\" to ~/.config/mise/conf.d/dotscurb-extras.toml, then mise install"; fi
  command -v dotagents >/dev/null 2>&1 && ok "dotagents" || no "dotagents missing" "mise install (needs Node 20+)"
  echo "Git"
  case $(git config --global core.hooksPath 2>/dev/null) in *dotscurb/hooks) ok "hooks path → dotscurb" ;;
    *) no "core.hooksPath is not dotscurb's hooks" "chezmoi apply (sets it in ~/.gitconfig)" ;; esac
  [ -n "$(git config --global user.name)" ] && [ -n "$(git config --global user.email)" ] && ok "name and email set" || no "git name/email not set" "git config --global user.name …; user.email …"
  [ -n "$(git config --global dotscurb.coauthor)" ] && ok "agent co-author line set" || no "dotscurb.coauthor not set" "chezmoi apply"
  if command -v gh >/dev/null 2>&1; then gh auth status >/dev/null 2>&1 && ok "GitHub CLI logged in" || no "GitHub CLI not logged in" "gh auth login"; fi
  echo "Agents (log in once per machine)"
  n=0
  if command -v claude >/dev/null 2>&1; then n=1; claude auth status 2>/dev/null | grep -q '"loggedIn": true' && ok "Claude Code logged in" || no "Claude Code not logged in" "claude (it asks you to log in)"; fi
  if command -v codex >/dev/null 2>&1; then n=1; codex login status 2>&1 | grep -qi '^logged in' && ok "Codex logged in" || no "Codex not logged in" "codex login"; fi
  if command -v cursor-agent >/dev/null 2>&1; then n=1; cursor-agent status 2>&1 | grep -qi 'logged in as' && ok "Cursor CLI logged in" || no "Cursor CLI not logged in" "cursor-agent login"; fi
  if command -v pi >/dev/null 2>&1; then n=1; [ -s "$HOME/.pi/agent/auth.json" ] && ok "pi has credentials" || no "pi has no credentials" "pi, then /login"; fi
  if command -v opencode >/dev/null 2>&1; then n=1; ok "OpenCode installed (log in with: opencode auth login)"; fi
  [ "$n" = 1 ] || no "no coding agent installed" "re-run chezmoi init and answer yes to one, or install one yourself"
  if command -v herdr >/dev/null 2>&1; then
    echo "herdr"
    st=$(herdr integration status 2>/dev/null)
    for a in claude codex pi opencode; do command -v "$a" >/dev/null 2>&1 || continue
      printf '%s\n' "$st" | grep -q "^$a: not installed" && no "herdr integration for $a missing" "herdr integration install $a" || ok "herdr integration for $a"; done
  fi
  echo "Skills, MCP servers, plugins"
  if command -v dotagents >/dev/null 2>&1; then
    (cd "$HOME" && dotagents --global doctor >/dev/null 2>&1) && ok "dotagents: everything installed" || no "dotagents reports problems" "dotagents --global doctor"
  fi
  out=$(cd "$HOME" && cmd_check --session 2>&1)
  [ -z "$out" ] && ok "nothing installed outside dotagents" || { printf '%s\n' "$out" | sed 's/^/    /'; no "items installed directly in an agent" "dotscurb check --fix"; }
  echo "Projects"
  dirs=$(project_dirs)
  if [ -z "$dirs" ]; then no "no project folder set" "git config --global --add dotscurb.projects ~/code   (chezmoi asks this on init)"
  else
    printf '%s\n' "$dirs" | while IFS= read -r d; do [ -d "$d" ] && ok "project folder ${d#$HOME/}" || printf '  ✗ project folder %s does not exist\n' "$d"; done
    for r in $(project_repos); do
      hp=$(git -C "$r" config --local core.hooksPath 2>/dev/null)
      [ -n "$hp" ] && no "${r#$HOME/}: own core.hooksPath ($hp) skips dotscurb's hooks" "if the repo doesn't need it: git -C $r config --unset core.hooksPath (husky etc. need it; see ROADMAP.md)"
      out=$(cd "$r" && cmd_check --session --project-only 2>&1)
      [ -n "$out" ] && no "${r#$HOME/}: project MCP/plugins outside dotagents" "cd $r && dotscurb check --fix"
    done
  fi
  echo
  [ "$todo" = 0 ] && echo "All set." || echo "$todo thing(s) to do above. Re-run 'dotscurb doctor' any time."
  return 0
}

cmd=${1:-help}; [ $# -gt 0 ] && shift
for a in "$@"; do [ "$a" = --quiet ] && QUIET=1; done
case $cmd in
  apply) cmd_apply ;;
  check) cmd_check "$@" ;;
  init) cmd_init "$@" ;;
  setup) cmd_setup ;;
  doctor) cmd_doctor ;;
  *) sed -n '2,12p' "$self" | sed 's/^# \{0,1\}//' ;;
esac
