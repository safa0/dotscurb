#!/bin/sh
# dotscurb: only the glue the other tools don't provide (chezmoi places files, mise installs tools, dotagents
# handles skills/MCP/plugins, git runs the hooks in ../hooks).
#   dotscurb apply         render the policy into Claude Code + Cursor CLI, and switch on in Claude the plugins
#                          dotagents declares (dotagents only generates the marketplace)
#   dotscurb check         list MCP servers and plugins installed outside dotagents (read-only)
#   dotscurb check --fix   move them into dotagents and remove the native copy (never copies secret values)
set -u

self=$0
while [ -L "$self" ]; do t=$(readlink "$self"); case $t in /*) self=$t ;; *) self=$(dirname "$self")/$t ;; esac; done
ROOT=$(cd "$(dirname "$self")/.." && pwd -P)
A="$HOME/.agents"
PATH="$HOME/.local/share/mise/shims:$HOME/.local/bin:$PATH"; export PATH
QUIET=0
TAB=$(printf '\t')

say() { [ "$QUIET" = 1 ] || printf '%s\n' "$*"; }
warn() { printf 'dotscurb: %s\n' "$*" >&2; }
need() { command -v "$1" >/dev/null 2>&1 || { warn "$1 not found (it comes from mise: mise install)"; exit 1; }; }

# put <file> <tmpfile>: replace contents only when they differ (keeps owner, group and mode)
put() {
  if [ -f "$1" ] && cmp -s "$2" "$1"; then rm -f "$2"; return 1; fi
  mkdir -p "$(dirname "$1")" && cat "$2" > "$1" && rm -f "$2" && say "updated ~/${1#$HOME/}"
}

# jsonedit <file> <jq-program> [jq args…]: apply only if the result differs semantically (no reformat churn)
jsonedit() {
  f=$1; prog=$2; shift 2
  [ -f "$f" ] || return 0
  new=$(mktemp) || return 1
  jq "$@" "$prog" "$f" > "$new" || { rm -f "$new"; warn "could not update $f"; return 1; }
  if [ "$(jq -S . "$f")" = "$(jq -S . "$new")" ]; then rm -f "$new"; return 0; fi
  put "$f" "$new"
}

policy_json() {
  def=$(yq -o=json '. // {}' "$ROOT/defaults/policy.yaml") || { warn "could not read defaults/policy.yaml (yq failed)"; exit 1; }
  per='{}'; [ -f "$A/policy.yaml" ] && { per=$(yq -o=json '. // {}' "$A/policy.yaml") || { warn "could not read ~/.agents/policy.yaml (yq failed)"; exit 1; }; }
  jq -n --argjson a "$def" --argjson b "$per" '
    def u: reduce .[] as $x ([]; if index([$x]) then . else . + [$x] end);
    { denyRead: (($a.denyRead // []) + ($b.denyRead // []) | u),
      denyWrite: (($a.denyWrite // []) + ($b.denyWrite // []) | u),
      denyCommands: (($a.denyCommands // []) + ($b.denyCommands // []) | u) }'
}

CP="$HOME/.claude/plugins"   # Claude Code's plugin records

cmd_apply() {
  need jq; need yq
  # 1. policy → Claude Code (deny rules, attribution off, session-start check)
  pol=$(policy_json)
  [ -f "$HOME/.claude/settings.json" ] || { mkdir -p "$HOME/.claude" && echo "{}" > "$HOME/.claude/settings.json"; }
  jsonedit "$HOME/.claude/settings.json" '
    .permissions.deny = [($p.denyRead[] | "Read(\(.))"), ($p.denyWrite[] | "Edit(\(.))"),
      ($p.denyCommands[] | if (.args // "") != "" then "Bash(\(.cmd) \(.args)*)" else "Bash(\(.cmd) *)" end)]
    | .attribution.commit = "" | .attribution.pr = ""
    | .hooks.SessionStart = ((.hooks.SessionStart // [])
        | if any(.[]; any(.hooks[]?; (.command // "") | test("dotscurb check"))) then .
          else . + [{"hooks": [{"type": "command", "command": $hook}]}] end)' \
    --argjson p "$pol" --arg hook "$HOME/.local/bin/dotscurb check --session"
  # 2. policy → Cursor CLI (absolute paths; Shell(cmd:args*) format)
  jsonedit "$HOME/.cursor/cli-config.json" '
    def abs: sub("^~/"; $home + "/");
    .permissions.deny = [($p.denyRead[] | "Read(\(abs))"), ($p.denyWrite[] | "Write(\(abs))"),
      ($p.denyCommands[] | if (.args // "") != "" then "Shell(\(.cmd):\(.args)*)" else "Shell(\(.cmd))" end)]
    | .attribution.attributeCommitsToAgent = false | .attribution.attributePRsToAgent = false' \
    --argjson p "$pol" --arg home "$HOME"
  # 3. plugins declared in ~/.agents/agents.toml → switched on in Claude Code (dotagents issue #176:
  #    it generates ~/.agents/.claude-plugin/marketplace.json but never registers or installs it)
  mk="$A/.claude-plugin/marketplace.json"
  if command -v claude >/dev/null 2>&1 && [ -f "$mk" ]; then
    jq -e '.dotagents' "$CP/known_marketplaces.json" >/dev/null 2>&1 || \
      { claude plugin marketplace add "$A" >/dev/null 2>&1 && say "Claude: added the dotagents plugin marketplace"; }
    claude plugin marketplace update dotagents >/dev/null 2>&1 || true
    want=$(jq -r '.plugins[].name' "$mk")
    have=$(jq -r '.plugins // {} | keys[] | select(endswith("@dotagents")) | sub("@dotagents$"; "")' "$CP/installed_plugins.json" 2>/dev/null)
    for n in $want; do printf '%s\n' "$have" | grep -qx -- "$n" && continue
      claude plugin install "$n@dotagents" --scope user >/dev/null 2>&1 && say "Claude: switched on plugin $n" || warn "Claude: could not install plugin $n"; done
    for n in $have; do printf '%s\n' "$want" | grep -qx -- "$n" && continue
      claude plugin uninstall "$n@dotagents" --scope user >/dev/null 2>&1 && say "Claude: switched off plugin $n (no longer in agents.toml)"; done
  fi
}

# --- check / fix -----------------------------------------------------------------------------------------
# normalise one native MCP entry (Claude/Cursor/pi JSON, Codex TOML, OpenCode) to {url, cmd, headers, envkeys, secret}
JQ_NORM='def lit: tostring | test("\\$\\{|\\{env:") | not;
  { url: (.url // null),
    cmd: (if .command then ([.command] + (.args // []) | flatten | map(tostring) | join(" ")) else null end),
    headers: ((.headers // .http_headers // {}) | to_entries | map("\(.key):\(.value)")),
    envkeys: (((.env // .environment // {}) | keys) + (.env_vars // [])),
    secret: ([(.env // .environment // {}), (.headers // .http_headers // {})] | add | to_entries
             | map(select(.value | lit)) | length > 0) }'
# mcp_from <file> <jq-path> <scope: user|project> <agent> [toml] → TSV: name scope agent json
mcp_from() {
  [ -f "$1" ] || return 0
  if [ "${5:-}" = toml ]; then yq -p toml -o json "$2 // {}" "$1" 2>/dev/null; else jq "$2 // {}" "$1" 2>/dev/null; fi \
    | jq -r --arg s "$3" --arg a "$4" "to_entries[] | [.key, \$s, \$a, (.value | $JQ_NORM | tojson)] | @tsv" 2>/dev/null
}
native_items() { # TSV: kind name scope agent detail
  repo=$1
  { mcp_from "$HOME/.claude.json" '.mcpServers' user Claude
    [ -n "$repo" ] && mcp_from "$HOME/.claude.json" ".projects[\"$repo\"].mcpServers" project Claude-local
    [ -n "$repo" ] && mcp_from "$repo/.mcp.json" '.mcpServers' project Claude
    mcp_from "$HOME/.cursor/mcp.json" '.mcpServers' user Cursor
    [ -n "$repo" ] && mcp_from "$repo/.cursor/mcp.json" '.mcpServers' project Cursor
    mcp_from "$HOME/.codex/config.toml" '.mcp_servers' user Codex toml
    [ -n "$repo" ] && mcp_from "$repo/.codex/config.toml" '.mcp_servers' project Codex toml
    mcp_from "$HOME/.pi/agent/mcp.json" '.mcpServers' user pi
    [ -n "$repo" ] && mcp_from "$repo/.pi/mcp.json" '.mcpServers' project pi
    mcp_from "$HOME/.config/opencode/opencode.json" '.mcp' user OpenCode
  } | sed "s/^/mcp$TAB/"
  # Claude plugins from a marketplace other than dotagents (claude.ai-synced ones are Claude's own)
  [ -f "$CP/installed_plugins.json" ] && jq -r --arg repo "$repo" --slurpfile km "$CP/known_marketplaces.json" '
    .plugins // {} | to_entries[] | (.key | split("@")) as [$n, $m]
    | select($m != "dotagents" and $m != "synced") | .value[]
    | select(.scope == "user" or .projectPath == $repo)
    | ["plugin", $n, (if .scope == "user" then "user" else "project" end), "Claude",
       ({market: $m, repo: ($km[0][$m].source.repo // null), ref: (.gitCommitSha // null), claudeScope: .scope} | tojson)]
    | @tsv' "$CP/installed_plugins.json" 2>/dev/null
  true
}

cmd_check() {
  need jq; need yq
  session=0; fix=0
  for a in "$@"; do case $a in --session) session=1 ;; --fix) fix=1 ;; esac; done
  repo=$(git rev-parse --show-toplevel 2>/dev/null || true)
  declared=""
  for t in "$A/agents.toml" ${repo:+"$repo/agents.toml"}; do
    [ -f "$t" ] || continue
    j=$(yq -p toml -o json '[(.mcp // [])[].name, (.plugins // [])[].name]' "$t") || { warn "could not read $t (yq failed)"; return 1; }
    declared="$declared
$(printf '%s' "$j" | jq -r '.[]')"
  done
  items=$(native_items "$repo" | while IFS="$TAB" read -r kind name scope agent detail; do
    [ -n "$name" ] || continue
    printf '%s\n' "$declared" | grep -qx -- "$name" && continue
    printf '%s\t%s\t%s\t%s\t%s\n' "$kind" "$name" "$scope" "$agent" "$detail"
  done | sort -u -t "$TAB" -k1,3)
  if [ -z "$items" ]; then [ "$session" = 1 ] || echo "dotscurb: everything is managed by dotagents"; return 0; fi
  if [ "$fix" = 0 ]; then
    echo "dotscurb: installed outside dotagents, so other agents and machines don't get them:"
    printf '%s\n' "$items" | while IFS="$TAB" read -r kind name scope agent detail; do
      s=""; [ "$(printf '%s' "$detail" | jq -r '.secret // false')" = true ] && s="  ⚠ secret value in config, move it by hand"
      printf '  - %s %s  (%s, %s)%s\n' "$kind" "$name" "$agent" "$( [ "$scope" = user ] && echo every project || echo this project)" "$s"
    done
    echo "Run 'dotscurb check --fix' to move them into dotagents (secret values are never copied)."
    return 0
  fi
  need dotagents
  printf '%s\n' "$items" | while IFS="$TAB" read -r kind name scope agent detail; do
    flag=--global; dir=$HOME; [ "$scope" = project ] && { flag=--project; dir=$repo; }
    if [ "$kind" = mcp ]; then
      if [ "$(printf '%s' "$detail" | jq -r .secret)" = true ]; then warn "skipped MCP $name ($agent): its config holds a secret value; move the value to an env var first"; continue; fi
      set -- mcp add "$name"
      url=$(printf '%s' "$detail" | jq -r '.url // empty'); cmdline=$(printf '%s' "$detail" | jq -r '.cmd // empty')
      if [ -n "$url" ]; then set -- "$@" --url "$url"
        for h in $(printf '%s' "$detail" | jq -r '.headers[] | @base64'); do set -- "$@" --header "$(printf '%s' "$h" | base64 -d)"; done
      elif [ -n "$cmdline" ]; then set -- "$@" --command "$cmdline"
      else warn "skipped MCP $name: neither url nor command"; continue; fi
      for e in $(printf '%s' "$detail" | jq -r '.envkeys[]'); do set -- "$@" --env "$e"; done
      case $agent in   # Claude keeps its own copy under a different scope; remove it so dotagents' copy is the only one
        Claude) (cd "$dir" && claude mcp remove "$name" -s user >/dev/null 2>&1) ;;
        Claude-local) (cd "$dir" && claude mcp remove "$name" -s local >/dev/null 2>&1) ;;
      esac
      (cd "$dir" && dotagents "$flag" "$@" >/dev/null 2>&1) && say "moved MCP $name ($agent) into dotagents ($flag)" || warn "could not add MCP $name to dotagents"
    else
      src=$(printf '%s' "$detail" | jq -r '.repo // empty'); ref=$(printf '%s' "$detail" | jq -r '.ref // empty')
      mkt=$(printf '%s' "$detail" | jq -r .market)
      if [ "$scope" != user ]; then warn "skipped plugin $name: project-scoped plugins are not moved yet"; continue; fi
      if [ -z "$src" ]; then warn "skipped plugin $name: its marketplace $mkt has no GitHub source"; continue; fi
      if (cd "$dir" && dotagents --global add "$src" --name "$name" ${ref:+--ref "$ref"} >/dev/null 2>&1); then
        claude plugin uninstall "$name@$mkt" --scope user >/dev/null 2>&1
        say "moved plugin $name ($src) into dotagents; removed Claude's own copy"
      else warn "could not add plugin $name ($src) to dotagents"; fi
    fi
  done
  (cd "$HOME" && dotagents --global sync >/dev/null 2>&1) || true
  [ -n "$repo" ] && [ -f "$repo/agents.toml" ] && (cd "$repo" && dotagents --project install >/dev/null 2>&1)
  cmd_apply
}

cmd=${1:-help}; [ $# -gt 0 ] && shift
for a in "$@"; do [ "$a" = --quiet ] && QUIET=1; done
case $cmd in
  apply) cmd_apply ;;
  check) cmd_check "$@" ;;
  *) sed -n '2,7p' "$self" | sed 's/^# \{0,1\}//' ;;
esac
